default:
    @just --list

# Install JavaScript dependencies
deps:
    bun install

[private]
deps-if-needed:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -d node_modules ]; then
        bun install
    fi

# Run the Astro dev server (http://localhost:4321 by default)
[group('run')]
dev: deps-if-needed
    bun run dev

# Build the static site to dist/
[group('build')]
build: deps-if-needed og
    bun run build

# Generate Open Graph cards (1200x630 PNGs in public/og/)
[group('build')]
og: deps-if-needed
    bun scripts/gen-og.mjs

# Preview the production build locally
[group('build')]
preview: deps-if-needed
    bun run preview

# Type-check the site
[group('test')]
check: deps-if-needed lint
    bun run check

# Format website source. Canonical Markdown mirrors are copied byte-for-byte
# from the repository and deliberately excluded here.
[group('format')]
format: deps-if-needed
    bun x oxfmt "**/*.{ts,tsx,css,mjs,json}"
    bun x prettier --write "**/*.astro"

# Lint with oxlint and check formatting with oxfmt + prettier
[group('format')]
lint: deps-if-needed
    bun x oxlint .
    bun x oxfmt --check "**/*.{ts,tsx,css,mjs,json}"
    bun x prettier --check "**/*.astro"

# Regenerate src/data/keybindings.json from the F# default keymap.
# Run after changing Keymap.defaults; the JSON is committed so site
# builds don't require the fedit binary.
[group('build')]
gen-keybinds:
    PATH="$PWD/../.dotnet:$PATH" dotnet build ../src/Fedit/Fedit.fsproj --nologo >/dev/null
    PATH="$PWD/../.dotnet:$PATH" dotnet run --project ../src/Fedit/Fedit.fsproj --no-build -- keybinds --json > src/data/keybindings.json
    bun x oxfmt src/data/keybindings.json

# Regenerate src/data/themes.json from the bundled F# themes (Themes.all).
# Run after changing Themes.fs; the JSON is committed so site builds don't
# require the fedit binary.
[group('build')]
gen-themes:
    PATH="$PWD/../.dotnet:$PATH" dotnet build ../src/Fedit/Fedit.fsproj --nologo >/dev/null
    PATH="$PWD/../.dotnet:$PATH" dotnet run --project ../src/Fedit/Fedit.fsproj --no-build -- themes --json > src/data/themes.json
    bun x oxfmt src/data/themes.json

# Regenerate src/data/commands.json from the command-palette parser specs.
[group('build')]
gen-commands:
    PATH="$PWD/../.dotnet:$PATH" dotnet build ../src/Fedit/Fedit.fsproj --nologo >/dev/null
    PATH="$PWD/../.dotnet:$PATH" dotnet run --project ../src/Fedit/Fedit.fsproj --no-build -- commands --json > src/data/commands.json
    bun x oxfmt src/data/commands.json

# Regenerate every committed reference dataset.
[group('build')]
gen-reference-data: gen-keybinds gen-themes gen-commands

# Copy canonical repository docs into the deployable website tree. These
# mirrors are committed so Vercel never needs to read outside website/.
[group('build')]
sync-canonical-docs:
    node scripts/sync-canonical-docs.mjs

# Refresh every source-derived website artifact.
[group('build')]
refresh-content: gen-reference-data sync-canonical-docs

# Fail when committed website data/docs no longer match canonical sources.
[group('test')]
verify-generated:
    PATH="$PWD/../.dotnet:$PATH" node scripts/verify-generated.mjs

# Remove build artifacts
[group('build')]
clean:
    rm -rf dist .astro

# Nuke everything (deps + build artifacts)
[group('build')]
nuke: clean
    rm -rf node_modules bun.lock
