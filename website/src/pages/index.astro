---
import Site from "../layouts/Site.astro";
import Symbol from "../components/Symbol.astro";
import CaretRise from "../components/mascots/CaretRise.astro";

const features = [
  {
    name: "native and quick",
    desc: "NativeAOT is the default release: roughly 7 MB and about 10 ms to first paint on the reference machine",
  },
  {
    name: "language servers",
    desc: "stdio LSP clients provide diagnostics, hover, definitions, references, Ctrl+Click, and jump-back",
  },
  {
    name: "tree-sitter",
    desc: "syntax highlighting for 25 languages plus structural expand and shrink selection",
  },
  {
    name: "semantic macros",
    desc: "record actions and command outcomes, replay async steps safely, and persist registers as plain text",
  },
  {
    name: "F# plugins",
    desc: "trusted plugins run in a separate .NET host and return typed actions over a JSON-RPC boundary",
  },
  {
    name: "hex + binary",
    desc: "detect binary files, edit raw bytes in a hex grid, search and replace, then save byte-for-byte",
  },
  {
    name: "terminal-native input",
    desc: "keyboard protocols, mouse placement and drag selection, multi-click selection, and Ctrl+Click navigation",
  },
  {
    name: "workspace editing",
    desc: "piece-table buffers, file tree, live watcher, command palette, search, clipboard, and thirteen themes",
  },
];

const cards = [
  {
    href: "/commands",
    title: "commands",
    blurb: "Every command bar verb, generated from the editor's parser specs.",
  },
  {
    href: "/themes",
    title: "themes",
    blurb: "Thirteen palettes, including light. Switch live from the command bar.",
  },
  {
    href: "/docs/plugins",
    title: "plugins",
    blurb: "Build F# commands and keybindings against the out-of-process plugin API.",
  },
  {
    href: "/docs/architecture",
    title: "architecture",
    blurb:
      "The deterministic update loop and its runtime, LSP, tree-sitter, and plugin boundaries.",
  },
  {
    href: "/brand",
    title: "brand",
    blurb: "Caret, Departure Mono, phosphor green. The voice rules and the do-not list.",
  },
];
---

<Site
  title="fedit — edit files in the terminal"
  description="A small NativeAOT terminal editor written in F#, with LSP navigation, tree-sitter highlighting, semantic macros, F# plugins, and byte-exact hex editing."
  image="/og/index.png"
  titleOverride
>
  <!-- ============================================================ -->
  <!-- HERO                                                         -->
  <!-- ============================================================ -->
  <section class="section hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-text">
          <div class="hero-brand">
            <Symbol size={56} color="var(--accent)" strokeWidth={3} class="hero-mark" />
            <h1>fedit</h1>
          </div>
          <p class="hero-lede">
            Edit files in the terminal. Small. Written in <span class="hero-key">F#</span>.
          </p>
          <p class="hero-actions">
            <a href="#install" class="cta-primary">Install fedit</a>
            <a
              href="https://github.com/HelgeSverre/fedit"
              class="cta-secondary"
              target="_blank"
              rel="noopener">View on GitHub</a
            >
          </p>
          <p class="caveat">One-line install on macOS, Linux, and Windows. See below.</p>
        </div>
        <div class="hero-mascot">
          <CaretRise />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- WHAT                                                         -->
  <!-- ============================================================ -->
  <section class="section section--alt">
    <div class="container">
      <div class="section__head">
        <h2>what</h2>
      </div>
      <div class="feature-grid">
        {
          features.map((f) => (
            <article class="feature">
              <h3>{f.name}</h3>
              <p>{f.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- INSTALL                                                      -->
  <!-- ============================================================ -->
  <section id="install" class="section">
    <div class="container">
      <div class="section__head"><h2>install</h2></div>

      <h3>macOS</h3>
      <pre
        ><span class="comment"># homebrew</span>
<span class="dim">$</span> brew install helgesverre/tap/fedit

<span class="comment"># or the install script</span>
<span class="dim">$</span> curl -fsSL https://fedit.dev/install.sh | sh</pre
      >
      <p class="muted-p">
        Both detect your CPU (arm64 / x64). Homebrew updates via <code>brew upgrade fedit</code>;
        the script installs to <code>~/.local/bin</code>.
      </p>

      <h3>linux</h3>
      <pre><span class="dim">$</span> curl -fsSL https://fedit.dev/install.sh | sh</pre>
      <p class="muted-p">
        Detects your CPU, verifies the checksum, and installs to <code>~/.local/bin</code>. Set <code
          >FEDIT_VERSION</code
        > to pin a release. Homebrew on Linux works too. Or grab the
        <a href="https://github.com/HelgeSverre/fedit/releases/latest">tarball</a> by hand.
      </p>

      <h3>windows</h3>
      <pre><span class="dim">&gt;</span> irm https://fedit.dev/install.ps1 | iex</pre>
      <p class="muted-p">
        Installs to <code>%LOCALAPPDATA%\Programs\fedit</code> and adds it to your user
        <code>PATH</code>. Or download the
        <a href="https://github.com/HelgeSverre/fedit/releases/latest"
          ><code>fedit-x86_64-pc-windows-msvc.zip</code></a
        > and extract it onto your <code>PATH</code>.
      </p>

      <h3>flags</h3>
      <dl class="dl-grid">
        <dt><code>--log &lt;path&gt;</code></dt>
        <dd>
          append a UTC-timestamped trace of every <code>Msg</code> and <code>Effect</code> to the file
          — for debugging without polluting the TUI
        </dd>
      </dl>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- READ NEXT                                                    -->
  <!-- ============================================================ -->
  <section class="section section--alt">
    <div class="container">
      <div class="section__head"><h2>read next</h2></div>
      <div class="card-grid">
        {
          cards.map((c) => (
            <a class="card" href={c.href}>
              <h3>{c.title}</h3>
              <p>{c.blurb}</p>
              <span class="card-arrow" aria-hidden="true">
                →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Site>

<style>
  /* ----- hero ----- */
  .hero {
    padding: var(--space-6) 0;
    background: var(--surface-1);
    border-top: none;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--space-5);
    align-items: center;
  }
  @media (max-width: 800px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
  .hero-brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .hero h1 {
    font-size: clamp(48px, 9vw, 72px);
    line-height: 1;
  }
  .hero-lede {
    font-family: var(--font-departure-mono);
    font-size: clamp(20px, 3.2vw, 26px);
    line-height: 1.35;
    color: var(--fg);
    margin: 0 0 var(--space-4);
    max-width: 36ch;
  }
  .hero-key {
    color: var(--accent);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
  }
  .caveat {
    color: var(--fg-muted);
    font-size: 13px;
    margin: 0;
  }
  .hero-mascot {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  @media (max-width: 800px) {
    .hero-mascot {
      order: -1;
      margin-bottom: var(--space-2);
    }
  }

  /* ----- CTA buttons ----- */
  .cta-primary,
  .cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-departure-mono);
    font-size: 16px;
    letter-spacing: -0.01em;
    padding: 14px 22px;
    border-radius: 2px;
    text-decoration: none;
    transition:
      transform var(--t-fast) var(--ease),
      background var(--t-fast) var(--ease),
      border-color var(--t-fast) var(--ease),
      color var(--t-fast) var(--ease);
  }
  .cta-primary {
    background: var(--accent);
    color: var(--accent-fg);
    border: 1px solid var(--accent);
  }
  .cta-primary:hover {
    background: var(--accent-700);
    border-color: var(--accent-700);
    color: var(--neutral-50);
    transform: translateY(-1px);
  }
  .cta-primary:active {
    transform: translateY(0);
  }
  .cta-secondary {
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--border-strong);
  }
  .cta-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-1px);
  }
  .cta-secondary:active {
    transform: translateY(0);
  }

  /* ----- what (feature grid) ----- */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4) var(--space-4);
  }
  .feature {
    padding: 0;
    background: none;
    border: none;
  }
  .feature h3 {
    font-family: var(--font-departure-mono);
    font-size: 14px;
    color: var(--fg);
    text-transform: none;
    letter-spacing: -0.01em;
    margin-top: 0;
  }
  .feature p {
    color: var(--fg-muted);
    font-size: 13px;
    margin-top: var(--space-1);
    line-height: 1.55;
  }

  /* ----- read next cards ----- */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-2);
  }
  /* Surface (fill/border/radius/transition + hover border) comes from the
     shared .card base in global.css; these are the home-grid specifics. */
  .card {
    position: relative;
    display: block;
    padding: var(--space-3);
    text-decoration: none;
    color: var(--fg);
  }
  .card:hover {
    transform: translateY(-1px);
  }
  .card h3 {
    font-family: var(--font-departure-mono);
    font-size: 18px;
    margin: 0 0 var(--space-1);
    color: var(--fg);
  }
  .card p {
    color: var(--fg-muted);
    font-size: 13px;
    line-height: 1.55;
    margin: 0;
    max-width: 40ch;
  }
  .card-arrow {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    color: var(--accent);
    transition: transform var(--t-base) var(--ease);
  }
  .card:hover .card-arrow {
    transform: translateX(2px);
  }
</style>
