---
import Site from "../layouts/Site.astro";
import { loadChangelog, renderInlineMarkdown } from "../data/changelog";

const changelog = loadChangelog();
---

<Site title="changelog" description="What changed in fedit, release by release.">
  <section class="section">
    <div class="container stack stack--lg">
      <div class="section__head">
        <h1>changelog</h1>
        <p class="section__lede">
          Release by release, newest first. Downloads and full notes in <a
            href="https://github.com/HelgeSverre/fedit/releases">GitHub releases</a
          >.
        </p>
      </div>
      {
        changelog.map((release) => (
          <section class="cl-entry prose">
            <h2>
              {release.version}
              {release.date ? (
                <span class="cl-date">{release.date}</span>
              ) : (
                <span class="cl-date">unreleased</span>
              )}
            </h2>
            <ul>
              {release.items.map((item) => (
                <li set:html={renderInlineMarkdown(item)} />
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</Site>

<style>
  /* The prose h2 rule (border-top in global.css) is the entry
   * separator — a border on the section too would draw a double line. */
  .cl-entry h2 {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--font-departure-mono);
  }
  .cl-date {
    font-size: 13px;
    color: var(--fg-subtle);
    font-family: var(--font-jetbrains-mono);
  }
  .cl-entry li {
    max-width: 90ch;
    color: var(--fg-muted);
  }
  .cl-entry :global(code) {
    color: var(--fg);
  }
</style>
