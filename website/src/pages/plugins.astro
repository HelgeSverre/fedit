---
import DocsLayout from "../layouts/DocsLayout.astro";

const examples = [
  {
    name: "wordcount",
    command: "wc",
    summary: "Count whitespace-separated words in the active buffer.",
    actions: "Notify",
  },
  {
    name: "journal",
    command: "journal",
    summary: "Insert a timestamp at the cursor and reveal the stamped file in the sidebar.",
    actions: "InsertText · RevealPath · Notify",
  },
  {
    name: "todo-count",
    command: "todocount",
    summary: "Walk the workspace file index and report the number of TODO markers.",
    actions: "Notify",
  },
  {
    name: "todo-list",
    command: "todolist",
    summary: "Create a clickable TODO report whose rows jump to the source location.",
    actions: "NewBuffer · SetBufferActivation · OpenFileAt · Notify",
  },
  {
    name: "todo-next",
    command: "todonext",
    summary: "Jump to the next TODO across open buffers and register a plugin keybinding.",
    actions: "MoveCursor · SwitchBuffer · RegisterKeybinding",
  },
  {
    name: "jot",
    command: "jot",
    summary: "Keep a session scratchpad of code locations, mark entries done, and jump back.",
    actions: "NewBuffer · ReplaceRange · RevealPath · OpenFilePreview",
  },
];
---

<DocsLayout
  title="reference plugins"
  description="Six real, bundled fedit plugin examples covering notifications, edits, scratch buffers, navigation, activation, and keybindings."
  image="/og/plugins.png"
>
  <div class="section__head">
    <h1>reference plugins</h1>
    <p class="section__lede">
      Real examples from the fedit repository. These are teaching projects, not a registry: there
      are no invented download counts, ratings, or remote install claims.
    </p>
  </div>

  <div class="install-note">
    <p>Clone the repository, then copy an example into your plugin directory:</p>
    <pre
      ><span class="dim">$</span> git clone --depth 1 https://github.com/HelgeSverre/fedit
<span class="dim">$</span> mkdir -p ~/.config/fedit/plugins
<span class="dim">$</span> cp -R fedit/examples/wordcount ~/.config/fedit/plugins/</pre
    >
    <p>
      Restart fedit or run <code>plugin reload</code>. Review the source first: plugins are trusted
      .NET code with no sandbox.
    </p>
  </div>

  <div class="examples">
    {
      examples.map((example) => (
        <article>
          <div class="example-head">
            <h2>{example.name}</h2>
            <code>:{example.command}</code>
          </div>
          <p>{example.summary}</p>
          <p class="actions">{example.actions}</p>
          <a
            href={`https://github.com/HelgeSverre/fedit/tree/main/examples/${example.name}`}
            target="_blank"
            rel="noopener"
          >
            read source →
          </a>
        </article>
      ))
    }
  </div>

  <p>
    Ready to write one? The <a href="/docs/plugins">plugin author guide</a> covers the manifest, host
    lifecycle, API contract, installation, and debugging.
  </p>
</DocsLayout>

<style>
  .install-note {
    max-width: 78ch;
    padding: var(--space-3);
    border-left: 3px solid var(--accent);
    background: var(--surface-2);
  }
  .install-note p:first-child {
    margin-top: 0;
  }
  .install-note p:last-child {
    margin-bottom: 0;
  }
  .examples {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .examples article {
    padding: var(--space-3);
    border: 1px solid var(--border);
    background: var(--surface-1);
  }
  .example-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    align-items: baseline;
  }
  .example-head h2 {
    margin: 0;
  }
  .example-head code {
    color: var(--accent);
  }
  .examples p {
    color: var(--fg-muted);
  }
  .actions {
    font-family: var(--font-jetbrains-mono);
    font-size: 11px;
  }
  @media (max-width: 680px) {
    .examples {
      grid-template-columns: 1fr;
    }
  }
</style>
