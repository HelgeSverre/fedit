---
import DocsLayout from "../layouts/DocsLayout.astro";
import commands from "../data/commands.json";

const renderSummary = (summary: string) =>
  summary
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replace(/`([^`]+)`/g, "<code>$1</code>");
---

<DocsLayout
  title="commands"
  description="Every built-in fedit command, generated from the parser and completion specs used by the editor."
  image="/og/commands.png"
>
  <div class="section__head">
    <h1>commands</h1>
    <p class="section__lede">
      Every built-in command accepted by the command palette. This page is generated from the same
      specs used by fedit's parser and completions.
    </p>
  </div>

  <div class="reference-note">
    <p>
      Press <kbd>Ctrl+P</kbd>, then type a command without the leading colon. Looking for shortcuts?
      See the <a href="/docs/keybindings">generated keybinding reference</a>.
    </p>
  </div>

  <div class="command-list">
    {
      commands.map((command) => (
        <article class="command-row">
          <div>
            <code class="command-usage">{command.usage}</code>
            {command.hidden && <span class="command-badge">keyboard-first</span>}
          </div>
          <p set:html={renderSummary(command.summary)} />
        </article>
      ))
    }
  </div>
</DocsLayout>

<style>
  .reference-note {
    max-width: 75ch;
    padding: var(--space-2) var(--space-3);
    border-left: 3px solid var(--accent);
    background: var(--surface-2);
  }
  .reference-note p {
    margin: 0;
    color: var(--fg-muted);
  }
  .command-list {
    border-top: 1px solid var(--border);
  }
  .command-row {
    display: grid;
    grid-template-columns: minmax(280px, 0.7fr) 1.3fr;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border);
    align-items: baseline;
  }
  .command-row p {
    margin: 0;
    color: var(--fg-muted);
  }
  /* Default fg, not accent: a full column of accent violates the
   * one-accent-per-surface rule (brand/USAGE.md). */
  .command-usage {
    color: var(--fg);
    background: transparent;
    border: 0;
    padding: 0;
  }
  .command-badge {
    display: block;
    margin-top: 5px;
    color: var(--fg-subtle);
    font-family: var(--font-jetbrains-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  @media (max-width: 640px) {
    .command-row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
