---
import Site from "./Site.astro";
import { docsNav } from "../data/docs-nav";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "");
const groups = [...new Set(docsNav.map((entry) => entry.group))];
---

<Site title={title} description={description} image={image}>
  <section class="section">
    <div class="container docs-shell">
      <aside class="docs-side">
        <details class="docs-side__disclosure" open>
          <summary>docs</summary>
          <script is:inline>
            // Collapsed by default on small screens — the full nav would
            // otherwise push the content a viewport down. Desktop keeps the
            // open state (the summary is hidden there).
            (function () {
              const disclosure = document.currentScript.closest("details");
              const narrow = window.matchMedia("(max-width: 720px)");
              const apply = () => (disclosure.open = !narrow.matches);
              apply();
              narrow.addEventListener("change", apply);
            })();
          </script>
          <nav aria-label="documentation">
            {
              groups.map((group) => (
                <section class="docs-side__group">
                  <h2>{group}</h2>
                  <ul>
                    {docsNav
                      .filter((entry) => entry.group === group)
                      .map((entry) => (
                        <li>
                          <a
                            href={entry.href}
                            aria-current={path === entry.href ? "page" : undefined}
                          >
                            {entry.label}
                          </a>
                        </li>
                      ))}
                  </ul>
                </section>
              ))
            }
          </nav>
        </details>
      </aside>
      <div class="docs-body stack stack--lg">
        <slot />
      </div>
    </div>
  </section>
</Site>

<style>
  .docs-shell {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 48px;
    align-items: start;
  }
  /* Grid children default to min-width auto, which lets wide content
   * (tables, long code) push the column past the viewport on small
   * screens. Let the column shrink and scroll wide tables in place. */
  .docs-body {
    min-width: 0;
  }
  .docs-body :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }
  .docs-side {
    position: sticky;
    top: 72px;
  }
  .docs-side ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .docs-side__group {
    margin-bottom: 22px;
  }
  /* Label indent = link padding + the 2px active-bar slot, so label and
   * link text share one left edge. */
  .docs-side__group h2 {
    margin: 0 0 6px 12px;
    color: var(--fg-subtle);
    font-family: var(--font-jetbrains-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .docs-side li {
    margin: 2px 0;
  }
  /* Nav-scale type (the header's 13px), not body scale — the sidebar
   * should recede next to the content column. */
  .docs-side a {
    display: block;
    padding: 5px 10px;
    border-radius: 2px;
    font-size: 13px;
    color: var(--fg-muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: color var(--t-base) var(--ease);
  }
  .docs-side a:hover {
    color: var(--fg);
  }
  .docs-side a[aria-current="page"] {
    color: var(--fg);
    border-left-color: var(--accent);
  }
  .docs-side a:focus-visible {
    outline: 3px solid var(--accent-soft);
    outline-offset: 2px;
  }
  .docs-side__disclosure > summary {
    display: none;
  }
  @media (max-width: 720px) {
    .docs-shell {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .docs-side {
      position: static;
    }
    .docs-side__disclosure > summary {
      display: block;
      cursor: pointer;
      font-family: var(--font-departure-mono);
      padding: 8px 0;
    }
  }
</style>
