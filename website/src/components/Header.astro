---
import Symbol from "./Symbol.astro";

const links = [
  { href: "/#install", label: "install" },
  { href: "/commands", label: "commands" },
  { href: "/themes", label: "themes" },
  { href: "/docs/plugins", label: "plugins" },
  { href: "/docs", label: "docs" },
  { href: "/changelog", label: "changelog" },
];

// The single longest href that prefixes the current path wins, so /docs
// doesn't light up alongside /docs/plugins.
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const current = links
  .filter(({ href }) => !href.includes("#"))
  .filter(({ href }) => path === href || path.startsWith(href + "/"))
  .sort((a, b) => b.href.length - a.href.length)[0]?.href;
---

<header class="site-head">
  <a class="skip-link" href="#top">skip to content</a>
  <div class="container">
    <a class="brand" href="/" aria-label="fedit home">
      <Symbol size={18} />
      <span class="brand-word">fedit</span>
    </a>
    <nav aria-label="primary">
      {
        links.map(({ href, label }) => (
          <a href={href} aria-current={href === current ? "page" : undefined}>
            {label}
          </a>
        ))
      }
      <a href="https://github.com/HelgeSverre/fedit" class="ext" target="_blank" rel="noopener"
        >github</a
      >
    </nav>
  </div>
</header>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(160%) blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .site-head .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    text-decoration: none;
    color: var(--fg);
  }
  .brand :global(svg) {
    align-self: center;
    color: var(--accent);
  }
  .brand-word {
    font-family: var(--font-departure-mono);
    font-size: 20px;
    letter-spacing: -0.02em;
  }
  nav {
    display: flex;
    gap: 4px;
    font-size: 13px;
    /* Narrow screens: the link row scrolls horizontally instead of
     * clipping — no wrap (keeps the 56px bar) and no visible scrollbar. */
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  nav::-webkit-scrollbar {
    display: none;
  }
  nav a {
    flex-shrink: 0;
  }
  nav a {
    color: var(--fg-muted);
    text-decoration: none;
    padding: 6px 10px;
    border-radius: 2px;
    position: relative;
    transition:
      color var(--t-base) var(--ease),
      background var(--t-base) var(--ease);
  }
  nav a::after {
    content: "";
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 2px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--t-base) var(--ease);
  }
  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--fg);
  }
  /* Visually hidden until keyboard focus, then a normal focusable link
   * pinned to the header's top-left. */
  .skip-link {
    position: absolute;
    left: 8px;
    top: 8px;
    padding: 6px 10px;
    background: var(--bg);
    color: var(--fg);
    text-decoration: none;
    transform: translateY(-200%);
  }
  .skip-link:focus-visible {
    transform: none;
    outline: 3px solid var(--accent-soft);
    outline-offset: 2px;
    z-index: 20;
  }
  nav a:hover::after {
    transform: scaleX(1);
  }
  /* Focus signal is the outline ring (see global.css). Underline grow is
     hover-only so quick tabbing doesn't trigger a 200ms scaleX animation
     on every focus change. */
  @media (max-width: 600px) {
    nav {
      gap: 0;
      font-size: 12px;
    }
    nav .ext {
      display: none;
    }
  }
</style>
